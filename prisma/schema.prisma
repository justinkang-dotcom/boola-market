generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  college         String
  classYear       Int
  bio             String    @default("")
  createdAt       DateTime  @default(now())
  listings        Listing[]
  reviewsReceived Review[]  @relation("SellerReviews")
  reviewsWritten  Review[]  @relation("BuyerReviews")
  threadsAsBuyer  Thread[]  @relation("BuyerThreads")
  threadsAsSeller Thread[]  @relation("SellerThreads")
  messages        Message[]
  bids            Bid[]
  salesAsSeller   Sale[]        @relation("SalesAsSeller")
  salesAsBuyer    Sale[]        @relation("SalesAsBuyer")
  saleMessages    SaleMessage[]
}

model Listing {
  id          String   @id @default(cuid())
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id])
  title       String
  description String
  priceCents  Int
  category    String
  subcategory String   @default("")
  condition   String
  imageUrl    String
  status      String   @default("active")
  saleType    String   @default("fixed")
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  threads     Thread[]
  reviews     Review[]
  bids        Bid[]
  sale        Sale?
}

model Bid {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id])
  bidderId    String
  bidder      User     @relation(fields: [bidderId], references: [id])
  amountCents Int
  createdAt   DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  sellerId  String
  seller    User     @relation("SellerReviews", fields: [sellerId], references: [id])
  buyerId   String
  buyer     User     @relation("BuyerReviews", fields: [buyerId], references: [id])
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id])
  rating    Int
  body      String
  createdAt DateTime @default(now())
}

model Sale {
  id           String        @id @default(cuid())
  listingId    String        @unique
  listing      Listing       @relation(fields: [listingId], references: [id])
  sellerId     String
  seller       User          @relation("SalesAsSeller", fields: [sellerId], references: [id])
  buyerId      String
  buyer        User          @relation("SalesAsBuyer", fields: [buyerId], references: [id])
  amountCents  Int
  status       String        @default("won")
  handoff      String        @default("pickup")
  delivery     Boolean       @default(false)
  paidMethod   String        @default("")
  sellerDone   Boolean       @default(false)
  buyerDone    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  messages     SaleMessage[]
}

model SaleMessage {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id])
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model Thread {
  id        String    @id @default(cuid())
  listingId String
  listing   Listing   @relation(fields: [listingId], references: [id])
  buyerId   String
  buyer     User      @relation("BuyerThreads", fields: [buyerId], references: [id])
  sellerId  String
  seller    User      @relation("SellerThreads", fields: [sellerId], references: [id])
  createdAt DateTime  @default(now())
  messages  Message[]

  @@unique([listingId, buyerId])
}

model Message {
  id         String   @id @default(cuid())
  threadId   String
  thread     Thread   @relation(fields: [threadId], references: [id])
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id])
  body       String
  offerCents Int?
  createdAt  DateTime @default(now())
}
